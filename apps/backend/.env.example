# MongoDB Atlas connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=travel_concierge
# Alternative variable name supported
# MONGO_URI=mongodb+srv://...

# Database Name
MONGODB_DATABASE=travel_concierge

# Autonomous Worker Service URL
WORKER_URL=http://localhost:8001

# Backend Server Host & Port
PORT=8000
HOST=0.0.0.0
